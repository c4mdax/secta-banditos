---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const products = await getCollection('products');

const merchFeatures = [
  "Libretas, camisetas, llaveros, stickers, peluches, souvenirs y más.",
  "Envíos a toda la República Mexicana 🇲🇽",
  "Artículos personalizables bajo pedido",
  "Hechos por el Clique, pero disponible para tod@s."
];
---

<Layout title="Catálogo Merch - Secta Banditos">
  <Navbar />
  
  <main 
    class="relative bg-clancy-dark text-clancy-white min-h-screen py-24 px-6 overflow-hidden" 
    transition:name="main-content" 
    transition:animate="slide"
  >
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-clancy-red/5 to-transparent pointer-events-none"></div>
    <div class="fixed inset-0 pointer-events-none z-10 scanlines opacity-10"></div>

    <div class="max-w-7xl mx-auto relative z-20">
      
      <header class="mb-20 reveal">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-[1px] w-12 bg-clancy-red shadow-[0_0_8px_#ff0000]"></div>
        </div>
        
        <h1 class="text-7xl md:text-9xl font-heading leading-[0.8] uppercase tracking-tighter mb-10">
          Fan <br/>
          <span class="clancy-title-red">Merch</span>
        </h1>

        <!-- Estilo de descripción idéntico al de "About" -->
        <div class="max-w-2xl border-l-4 border-clancy-red pl-6 py-2">
          <p class="text-xl md:text-2xl text-clancy-white font-bold leading-tight tracking-tight mb-6">
            Libretas, camisetas, llaveros, stickers, peluches, souvenirs y más.
          </p>
          <div class="space-y-3 text-clancy-white/60 leading-relaxed font-light text-sm md:text-base">
            <p>• Envíos a toda la República Mexicana 🇲🇽</p>
            <p>• Artículos personalizables bajo pedido.</p>
            <p>• Hechos por el Clique, pero disponibles para tod@s.</p>
          </div>
        </div>
      </header>

      <!-- Grid de Productos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {products.map((product, i) => (
          <article 
            class="reveal flex flex-col bg-white/[0.02] border border-white/5 relative group overflow-hidden transition-all duration-500 hover:border-white/20 hover:bg-white/[0.04]" 
            style={`animation-delay: ${i * 100}ms`}
          >
            <!-- Resplandor sutil -->
            <div class="absolute -right-10 -top-10 w-32 h-32 blur-[60px] opacity-20 rounded-full transition-opacity group-hover:opacity-40" style={`background-color: ${product.data.color};`}></div>
            
            <!-- Contenedor de Imagen -->
            <div class="relative aspect-square overflow-hidden bg-black/40 border-b border-white/5 flex items-center justify-center p-6">
              <Image 
                src={product.data.image} 
                alt={product.data.name} 
                class="w-full h-full object-contain relative z-10 filter grayscale-[0.2] group-hover:scale-105 transition-all duration-700" 
              />
              <div class="absolute top-4 left-4 z-25">
                <span class="text-[9px] uppercase font-black tracking-widest px-3 py-1 bg-black/80 border backdrop-blur-sm" style={`border-color: ${product.data.color}50; color: ${product.data.color};`}>
                  {product.data.vendor}
                </span>
              </div>
            </div>

            <!-- Detalles del Producto -->
            <div class="p-6 flex flex-col flex-grow relative z-10">
              <h3 class="text-xl font-heading uppercase leading-tight mb-2 text-white group-hover:tracking-tight transition-all">
                {product.data.name}
              </h3>
              
              <div class="flex-grow">
                <p class="text-clancy-red font-bold text-lg tracking-widest mb-6">
                  {product.data.price}
                </p>
              </div>

              <!-- Botón que va directo a Instagram -->
<a 
  href={product.data.link} 
  target="_blank"
  class="inline-block text-center border font-black px-6 py-3 uppercase text-[10px] tracking-[0.3em] transition-all skew-x-[-12deg] hover:bg-white hover:text-black w-full"
  style={`border-color: ${product.data.color}; color: ${product.data.color};`}
>
  <span class="inline-block skew-x-[12deg]">Comprar →</span>
</a>
            </div>
          </article>
        ))}
      </div>

      <footer class="mt-32 text-center reveal">
        <div class="w-full h-px bg-gradient-to-r from-transparent via-clancy-red to-transparent opacity-30 mb-12"></div>
        <div class="max-w-2xl mx-auto">
          <p class="text-clancy-red font-black text-xs uppercase tracking-[0.5em] mb-6 flicker-slow">Logística de Entrega</p>
          <p class="text-clancy-white/40 text-[10px] md:text-xs uppercase tracking-[0.25em] leading-relaxed italic">
            La transacción y entrega se coordinan directamente con el creador a través de sus redes oficiales.
          </p>
        </div>
      </footer>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  /* VIBRANT ANIMATED BULLET */
  .vibrant-bullet {
    width: 8px;
    height: 8px;
    background-color: var(--bullet-clr);
    transform: rotate(45deg);
    position: relative;
    box-shadow: 0 0 10px var(--bullet-clr);
    animation: bullet-glow 2s infinite ease-in-out;
  }

  .vibrant-bullet::after {
    content: '';
    position: absolute;
    inset: -2px;
    border: 1px solid var(--bullet-clr);
    animation: bullet-pulse 2s infinite ease-out;
  }

  @keyframes bullet-glow {
    0%, 100% { filter: brightness(1) drop-shadow(0 0 2px var(--bullet-clr)); transform: rotate(45deg) scale(1); }
    50% { filter: brightness(1.5) drop-shadow(0 0 8px var(--bullet-clr)); transform: rotate(225deg) scale(1.2); }
  }

  @keyframes bullet-pulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  /* CLANCY TITLE STYLING */
  .clancy-title-red {
    color: #ff0000;
    transform: scaleY(1.15);
    display: inline-block;
    filter: drop-shadow(0 0 15px rgba(255, 0, 0, 0.5));
    letter-spacing: -0.05em;
    font-weight: 900;
  }

  .reveal { 
    opacity: 0; 
    transform: translateY(20px); 
    animation: fadeInUp 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; 
  }

  @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

  .scanlines { 
    background: repeating-linear-gradient(to bottom, transparent 0px, transparent 2px, rgba(0, 0, 0, 0.3) 2px, rgba(0, 0, 0, 0.3) 4px); 
  }

  .flicker-slow { animation: flicker 4s infinite alternate; }
  @keyframes flicker {
    0%, 19.999%, 22%, 62.999%, 64%, 64.999%, 70%, 100% { opacity: 1; }
    20%, 21.999%, 63%, 63.999%, 65%, 69.999% { opacity: 0.4; }
  }
</style>